# Copy this file to .env and fill in your values
# NEVER commit .env to source control

# Your GitHub Personal Access Token
# Needs scopes: repo (full), workflow (if template has Actions)
# Generate at: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_your_token_here

# The GitHub owner and repo name of your template
# e.g. if your template is at github.com/johndoe/my-vibe-template
GITHUB_TEMPLATE_OWNER=your_github_username
GITHUB_TEMPLATE_REPO=your_template_repo_name

# The GitHub account where new repos will be created
# For now this is your personal account — swap to Tricentis org later
GITHUB_TARGET_OWNER=your_github_username

# Port the API runs on locally
PORT=3001

# Environment — controls error verbosity ("development" shows internal hints, "production" hides them)
NODE_ENV=development

# GitHub zip provider: "dev" (Octokit + PAT) or "prod" (OktoKit / GitHub App — not yet implemented)
GITHUB_PROVIDER=dev

# Whether created repos are private (false for personal dev, true for Tricentis prod)
GITHUB_REPO_PRIVATE=false

# Polling config for waiting on the Actions bot commit before fetching the zip
GITHUB_READY_TIMEOUT_MS=60000
GITHUB_POLL_INTERVAL_MS=2000
