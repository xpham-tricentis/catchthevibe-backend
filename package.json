{
  "name": "catchthevibe-backend",
  "version": "1.0.0",
  "description": "CatchTheVibe backend API — repo provisioning and zip download",
  "type": "module",
  "main": "src/server/index.js",
  "scripts": {
    "start": "node src/server/index.js",
    "dev:server": "node --watch src/server/index.js",
    "dev:client": "vite",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build": "vite build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.55.0",
    "@octokit/rest": "^21.0.0",
    "express": "^4.19.0",
    "dotenv": "^16.4.0",
    "@prisma/client": "^6.0.0",
    "@azure/identity": "^4.0.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "lucide-react": "^1.7.0"
  },
  "devDependencies": {
    "prisma": "^6.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "vite": "^6.3.0",
    "concurrently": "^9.0.0"
  }
}
