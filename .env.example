# Copy this file to .env and fill in your values
# NEVER commit .env to source control

# Anthropic API key — used by the /app-scoping interview (POST /api/apps/scope)
# Generate at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Your GitHub Personal Access Token
# Needs scopes: repo (full), workflow (if template has Actions)
# Generate at: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_your_token_here

# The GitHub owner and repo name of your template
# e.g. if your template is at github.com/johndoe/my-vibe-template
GITHUB_TEMPLATE_OWNER=your_github_username
GITHUB_TEMPLATE_REPO=your_template_repo_name

# The GitHub account where new repos will be created
# For now this is your personal account — swap to Tricentis org later
GITHUB_TARGET_OWNER=your_github_username

# PostgreSQL connection string (dev: local Postgres or Docker)
# docker run -d --name ctv-db -e POSTGRES_PASSWORD=dev -e POSTGRES_DB=catchthevibe -p 5432:5432 postgres:16
DATABASE_URL=postgresql://postgres:dev@localhost:5432/catchthevibe

# Port the API runs on locally
PORT=3001

# Environment — controls error verbosity ("development" shows internal hints, "production" hides them)
NODE_ENV=development

# GitHub zip provider: "dev" (Octokit + PAT) or "prod" (OktoKit / GitHub App — not yet implemented)
GITHUB_PROVIDER=dev

# Team name used in repo naming convention: vibe-{team}-{app}
# In prod this will be derived from SSO group membership
GITHUB_TEAM_NAME=dev

# Whether created repos are private (false for personal dev, true for Tricentis prod)
GITHUB_REPO_PRIVATE=false

# Polling config for waiting on the Actions bot commit before fetching the zip
GITHUB_READY_TIMEOUT_MS=60000
GITHUB_POLL_INTERVAL_MS=2000

# Beta only: commit the /app-scoping interview transcript to .catchthevibe/scoping-transcript.md
# in each newly provisioned repo. Leave false outside of beta.
CAPTURE_SCOPING_TRANSCRIPT=false
